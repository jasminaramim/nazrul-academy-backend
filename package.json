{
  "name": "nazrul-academy-backend",
  "version": "1.0.0",
  "description": "Trishal Nazrul Academy - Backend API Server",
  "main": "server.ts",
  "scripts": {
    "dev": "node api.js && tsx watch server.ts",
    "build": "node api.js && esbuild server.ts --bundle --platform=node --target=node12 --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "node api.js && node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.13.11",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@vercel/node": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
